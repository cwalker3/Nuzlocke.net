<div class="game">
  <nav class="game__nav"></nav>
  <div class="game__content">
    <div class="game__content-left">
      <%= turbo_frame_tag 'game-content-left' %>
    </div>
    <div class="game__content-main">
      <%=  turbo_frame_tag 'game-content-main', src: game_areas_path_with_attempt(@game, @attempt) %>
    </div>
    <div class="game__content-right">
      <%= render partial: 'attempt_pokemon/box', locals: { box: @box } %>
    </div>
  </div>
</div>